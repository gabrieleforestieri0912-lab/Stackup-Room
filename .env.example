# Copia in .env e compila con i valori reali. MAI committare .env.
# cp .env.example .env

# --- Supabase (obbligatorie) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
ADMIN_EMAILS=

# --- Stripe pagamenti corsi (obbligatorie per checkout/webhook) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe Connect verifiche Room ---
STRIPE_CONNECT_CLIENT_ID=

# --- Email (obbligatorie per contact/OTP) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Auth OTP ---
OTP_PEPPER=

# --- Coach AI Room (obbligatoria per coach/transcribe) ---
XKIRO_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=50
DEEPGRAM_API_KEY=

# --- Community (opzionali: senza, GIF e GitHub arricchiti sono disabilitati) ---
TENOR_API_KEY=
GITHUB_TOKEN=

# --- Analytics/monitoraggio (opzionali) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=
