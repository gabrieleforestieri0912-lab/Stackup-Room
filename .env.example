# Supabase — progetto dedicato Stackup Room (non riusare progetti di altri prodotti Vertex)
# Anon key è safe lato client per design Supabase. Service role MAI qui.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Launch gating — Giorno 5 Fase 1
# Se false, l'app mostra schermata waitlist invece del signup (verifica docs/scope.md: default true = public).
# ENABLE_PUBLIC_SIGNUP=true
# ENABLE_PUBLIC_SIGNUP=false  # attiva waitlist + TestFlight/Internal Testing come beta reale

# Opzionale: override via --dart-define (priorità su .env)
# flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
